    { "alias": "pc-claude", "host": "host", "engine": "claude", "workspace": "C:\\Projects\\example", "permissionLevel": "native" },
    { "alias": "vm-code", "host": "vm", "engine": "codex", "workspace": "C:\\Projects\\example" },
    { "alias": "vm-open", "host": "vm", "engine": "opencode", "workspace": "C:\\Projects\\example", "opencodeUrl": "http://127.0.0.1:4096", "opencodeApiVersion": "auto", "permissionLevel": "native" },
    { "alias": "vm-claude", "host": "vm", "engine": "claude", "workspace": "C:\\Projects\\example", "permissionLevel": "native" }
  ],
  "allowedControllers": []
