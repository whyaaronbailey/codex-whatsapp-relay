{
  "name": "codex-whatsapp",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp control of Codex, OpenCode and Claude Code on a PC and VM, with named sessions and file transfers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whyaaronbailey/codex-whatsapp-relay.git"
  },
  "homepage": "https://github.com/whyaaronbailey/codex-whatsapp-relay",
  "bugs": {
    "url": "https://github.com/whyaaronbailey/codex-whatsapp-relay/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "whatsapp:pair": "node ./scripts/pair-whatsapp.mjs",
    "whatsapp:start": "node ./scripts/start-controller.mjs",
    "whatsapp:auth": "node ./plugins/whatsapp-relay/scripts/whatsapp-auth.mjs",
    "whatsapp:controller": "node ./plugins/whatsapp-relay/scripts/controller-daemon.mjs",
    "whatsapp:install-chatterbox": "node ./plugins/whatsapp-relay/scripts/install-chatterbox.mjs",
    "whatsapp:mcp": "node ./plugins/whatsapp-relay/scripts/mcp-server.mjs",
    "whatsapp:status": "node ./plugins/whatsapp-relay/scripts/whatsapp-status.mjs",
    "whatsapp:tts:smoke": "node ./plugins/whatsapp-relay/scripts/voice-replier-smoke.mjs",
    "check": "node ./scripts/verify.mjs check",
    "test": "node ./scripts/verify.mjs test",
    "release:prepare": "node ./scripts/release.mjs"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "franc": "^6.2.0",
    "pino": "^9.9.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.1.11"
  }
}
